# Salin menjadi .env.local lalu isi dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# URL aplikasi (dipakai untuk link reset password & konfirmasi email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Supabase Dashboard > Project Settings > API > service_role (secret).
# Dibutuhkan untuk login dengan username. JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsional: fitur AI (Claude). Tanpa kunci ini, tombol AI menampilkan petunjuk pengaturan.
ANTHROPIC_API_KEY=
